# =====================================================================
#  SERVEROVÉ PREMENNÉ (nikdy sa nedostanú do kódu v prehliadači)
# =====================================================================

# API kľúč služby Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Adresa, na ktorú sa doručujú správy z formulára (skutočný e-mail Frederika Urbančíka)
CONTACT_EMAIL=

# Odosielateľ – adresa na doméne overenej v Resend, napr. "Web <web@vasa-domena.sk>"
CONTACT_FROM_EMAIL=

# Voliteľné: povolený pôvod požiadaviek (napr. https://www.vasa-domena.sk). Prázdne = bez kontroly.
ALLOWED_ORIGIN=

# =====================================================================
#  VEREJNÉ ÚDAJE (použijú sa pri builde, zobrazia sa na webe)
#  Alternatívne ich vyplňte priamo v site.config.ts
# =====================================================================
PUBLIC_EMAIL=
PUBLIC_PHONE=
PUBLIC_PHONE_E164=
BUSINESS_ADDRESS=
SITE_URL=
REG_STATUS=
REG_NBS_NUMBER=
REG_PRINCIPAL=
REG_SECTORS=
REG_ICO=
